{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-applj",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9c85642f-4fc6-4ded-bffb-08c163ef1850","database_name": "web-appjbh" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b231225e7e1d418bac5e83cda16cca42" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
